# syntax=docker/dockerfile:1.7
#
# Embernet Ignition Cloud (Standard edition) ${IGNITION_VERSION} — containerized.
#
# Wraps Inductive Automation's Linux x86-64 BitRock InstallBuilder
# installer (.run) into a debian:bookworm-slim base. Installer is
# self-extracting and supports unattended mode; we use --mode
# unattended + --prefix to land the install at a known path, then
# copy the resulting tree into a slim runtime stage.
#
# Companion to Containerfile (Edge ARM64 + x86-64, ZIP-based). Cloud
# is shipped as a .run installer ONLY (no portable zip on GitHub
# release v8.3.4), and is x86-64 ONLY — there's no aarch64 .run for
# Cloud. amd64 build only.
#
# Built with:
#   podman build --platform linux/amd64 \
#     --build-arg IGNITION_VERSION=8.3.8 \
#     -t ghcr.io/embernet-ai/ignition-cloud:8.3.8 \
#     -f Containerfile.cloud .

ARG IGNITION_VERSION=8.3.8

# ─── Stage 1: download + unattended-install the .run ─────────────────────────
FROM --platform=linux/amd64 debian:bookworm-slim AS installer

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      curl ca-certificates \
      libfontconfig1 fontconfig-config tzdata bash procps \
 && rm -rf /var/lib/apt/lists/*

ARG IGNITION_VERSION

# IA's installer refuses to run as root without an explicit
# user=<existing-unix-user> arg. cp01 creates the 'ignition' service
# user first then passes user=ignition. Mirror that here.
RUN useradd --system --create-home --home-dir /opt/embernet/ignition \
      --shell /bin/false ignition

WORKDIR /tmp
# IA's Linux installer is a makeself self-extracting archive that wraps
# IA's own install script. The makeself args go BEFORE `--`; everything
# after `--` is passed to the embedded installer.
#
# Working flag set lifted from deploy-ut3-cp01.sh (which has been
# installing Cloud successfully on bare-metal Ubuntu for months):
#   ./installer.run -- unattended=text location=/usr/local/bin/ignition user=ignition
#
# Accepted embedded-installer args (from `--help`):
#   unattended=(graphical|minimal|text|none)
#   textMode=(true|false)
#   location=<dir>
#   user=<existing unix user>   ← REQUIRED when running as root
RUN curl -fSL --retry 3 --retry-delay 5 \
      -o ignition-installer.run \
      "https://github.com/Embernet-ai/ignition-packages/releases/download/v${IGNITION_VERSION}/ignition-cloud-${IGNITION_VERSION}-linux-64-installer.run" \
 && chmod +x ignition-installer.run \
 && ./ignition-installer.run -- \
      unattended=text \
      location=/usr/local/bin/ignition \
      user=ignition \
      2>&1 | tail -60 || true \
 && echo "=== searching for ignition.sh in the filesystem ===" \
 && IGNITION_SH="$(find / -xdev -name 'ignition.sh' -type f 2>/dev/null | head -1)" \
 && if [ -z "${IGNITION_SH}" ]; then \
      echo "FATAL: ignition.sh not found anywhere after install — installer failed silently" >&2; \
      ls -la /usr/local/bin/ /usr/local/ /opt/ 2>/dev/null || true; \
      exit 1; \
    fi \
 && IGNITION_ROOT="$(dirname "${IGNITION_SH}")" \
 && echo "Installer dropped Ignition at: ${IGNITION_ROOT}" \
 && if [ "${IGNITION_ROOT}" != "/usr/local/bin/ignition" ]; then \
      echo "Relocating ${IGNITION_ROOT} -> /usr/local/bin/ignition"; \
      mkdir -p /usr/local/bin; \
      mv "${IGNITION_ROOT}" /usr/local/bin/ignition; \
    fi \
 && rm -f ignition-installer.run \
 && find /usr/local/bin/ignition -type f -name '*.sh' -exec chmod 755 {} + \
 && chmod 755 /usr/local/bin/ignition/ignition-gateway \
 && { test -x /usr/local/bin/ignition/ignition-util.sh || { echo "FATAL: ignition-util.sh missing or not executable after chmod" >&2; ls -la /usr/local/bin/ignition/ignition-util.sh 2>&1; exit 1; }; } \
 && ls /usr/local/bin/ignition | head -20

# ─── Stage 2: runtime image ──────────────────────────────────────────────────
FROM --platform=linux/amd64 debian:bookworm-slim

ARG IGNITION_VERSION

LABEL org.opencontainers.image.title="Embernet Ignition Cloud ${IGNITION_VERSION} (x86-64)"
LABEL org.opencontainers.image.description="Inductive Automation Ignition (Standard / Cloud edition) ${IGNITION_VERSION} packaged for x86-64 deployment via Quadlet on EmberNet control-plane appliances. Co-resident with Edge on UT3 cp02 (different ports)."
LABEL org.opencontainers.image.vendor="Fireball Industries"
LABEL org.opencontainers.image.source="https://github.com/Embernet-ai/ignition-packages"
LABEL ignition.version="${IGNITION_VERSION}"
LABEL ignition.edition="standard"

# Same minimal runtime deps as Edge — bundled JRE handles Java itself.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      libfontconfig1 fontconfig-config \
      tzdata bash procps tini \
 && rm -rf /var/lib/apt/lists/*

# Recreate the 'ignition' service user from the installer stage with the
# same UID/GID (999) so the install tree's ownership stays consistent
# across the COPY. The tree is chowned to this user, so it must exist.
RUN groupadd --system --gid 999 ignition \
 && useradd --system --uid 999 --gid 999 \
      --home-dir /usr/local/bin/ignition --shell /bin/false ignition

# Bring the unattended install tree from the installer stage.
COPY --from=installer /usr/local/bin/ignition /usr/local/bin/ignition

# Neutralize RUN_AS_USER, or the container exits 1 instantly with no output.
#
# We pass `user=ignition` to the .run installer (IA refuses to install as root
# without it), and the installer bakes `RUN_AS_USER=ignition` into ignition.sh.
# At startup ignition.sh then re-execs itself via `runuser - ignition`, which
# opens a LOGIN shell -- and this user's shell is /bin/false, so the re-exec
# returns 1. `set -e` in CMD turns that into an immediate container death, and
# because the failure happens before any log file is created, `podman logs` /
# `kubectl logs` show absolutely nothing.
#
# The Edge image never hits this: it is built from IA's portable ZIP, whose
# ignition.sh has no RUN_AS_USER. Commenting it out here puts Cloud on the same
# footing rather than inventing a second startup contract. Run the gateway as a
# non-root user via the runtime's securityContext / --user instead, which is the
# orchestrator's job and does not depend on a login shell existing.
#
# This was previously patched at runtime by an entrypoint override in
# deploy-ut3-cp02.sh, so podman hosts appeared to work while any plain
# `podman run` or Kubernetes Deployment of this image did not.
RUN sed -i 's/^RUN_AS_USER=/#RUN_AS_USER=/' /usr/local/bin/ignition/ignition.sh \
 && ! grep -q '^RUN_AS_USER=' /usr/local/bin/ignition/ignition.sh

# Let container args reach the gateway as Wrapper property overrides.
#
# ignition.sh ignores trailing `wrapper.*=*` arguments unless PASS_THROUGH is
# enabled -- it prints usage and exits 2 instead. The knob ships commented out
# (`#PASS_THROUGH=app_args`). `both` is the value we want: properties first,
# with an optional `--` separator before application arguments. The script's own
# normalizer keeps `both` as-is:
#     elif [ "X${PASS_THROUGH}" != "Xboth" ] ; then PASS_THROUGH=false
# so this must be exactly `both`, not `true`, which collapses to app_args.
RUN sed -i 's/^#PASS_THROUGH=.*/PASS_THROUGH=both/' /usr/local/bin/ignition/ignition.sh \
 && grep -q '^PASS_THROUGH=both' /usr/local/bin/ignition/ignition.sh

WORKDIR /usr/local/bin/ignition

# Default Cloud port set — matches the UT3 cp02 Quadlet remap so a
# zero-config pull-and-run works on a host where Edge already owns
# 8088/8043/8060. Override via Quadlet Environment= if Cloud is the
# only Ignition on the box.
EXPOSE 8089/tcp 8044/tcp 8061/udp

ENV ACCEPT_IGNITION_EULA=Y \
    IGNITION_EDITION=standard \
    GATEWAY_ADMIN_USERNAME=admin \
    GATEWAY_ADMIN_PASSWORD=embernet \
    GATEWAY_HTTP_PORT=8089 \
    GATEWAY_HTTPS_PORT=8044 \
    GATEWAY_GAN_PORT=8061 \
    DISABLE_QUICKSTART=true \
    LANG=C.UTF-8

# Same start pattern as the Edge image — ignition.sh backgrounds the
# gateway via the wrapper; tail -F keeps PID 1 alive for podman.
#
# The startup script lives in the entrypoint, NOT in CMD. Container args replace
# CMD, so an inline `bash -c "<script>"` CMD meant any `args:` from a chart threw
# the whole startup away and ran the argument as a command instead. Keeping CMD
# empty makes args arrive as "$@" and get forwarded to the gateway.
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 0755 /usr/local/bin/entrypoint.sh

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
CMD []
